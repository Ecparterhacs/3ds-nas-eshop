# Directory that contains your own .cia/.3ds/.3dsx files.
ESHOP_GAMES_DIR=/volume2/myfile/3dsrom

# Runtime metadata. The server creates db/ and covers/ below this directory.
ESHOP_DATA_DIR=/volume1/homes/your-user/3ds-nas-eshop/data

# Optional individual overrides:
# ESHOP_DB_PATH=/volume1/homes/your-user/3ds-nas-eshop/data/db/games.db
# ESHOP_COVERS_DIR=/volume1/homes/your-user/3ds-nas-eshop/data/covers

ESHOP_PORT=40441
